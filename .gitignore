# ---------------------------------------------------------------------------
# APM (Agent Package Manager)
# ---------------------------------------------------------------------------
# Installed dependencies (like node_modules). Restored by `apm install`.
apm_modules/

# Bundles produced by `apm pack`
build/
*.apm.zip

# Per-user / local overrides
.apm/local/
*.local.yml
*.local.yaml

# NOTE: commit apm.yml and apm.lock.yaml (reproducible installs).
#
# If you test-install your own package inside this repo, the deployed copies
# below are generated output. Uncomment the ones you don't want to commit:
.agents/skills/
.claude/skills/
.github/skills/
.kiro/skills/
.grok/skills/

